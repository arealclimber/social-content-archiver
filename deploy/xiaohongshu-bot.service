[Unit]
Description=Crawler File Discord Bot
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/crawler-file-discord-bot
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/ubuntu/crawler-file-discord-bot/venv/bin/python run_discord_bot.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target 
